{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-brain-lab.local/contracts/brain/status.schema.json",
  "title": "BrainMessage",
  "description": "두뇌가 화면에 보내는 메시지. 상태는 1초에 5번, 판단 기록과 지시의 답은 생길 때마다.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/BrainStatus"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/ControlResult"
    }
  ],
  "$defs": {
    "SkillState": {
      "title": "SkillState",
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "idle",
            "hold",
            "engage",
            "retreat"
          ]
        },
        "target": {
          "description": "지시받은 표적 (없으면 두뇌가 고름)",
          "type": [
            "string",
            "null"
          ]
        },
        "evasion": {
          "enum": [
            "dodge",
            "guard",
            "both",
            "none"
          ]
        }
      },
      "required": [
        "name",
        "target",
        "evasion"
      ],
      "additionalProperties": false
    },
    "Reflex": {
      "title": "Reflex",
      "description": "지금 하고 있는 반사 행동. kind: dodge 피하기·guard 막기·both 둘 다, threat: 조준한 유닛, until: 끝낼 시뮬레이션 시각",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "dodge",
            "guard",
            "both"
          ]
        },
        "threat": {
          "type": "string"
        },
        "until": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "threat",
        "until"
      ],
      "additionalProperties": false
    },
    "Metrics": {
      "title": "Metrics",
      "description": "tickMicrosAvg·Max: 판단 한 번에 걸린 시간(µs, 최근 5초), commandsPerSecond: 몸에 보낸 명령 수, lastReactionMs: 마지막 조준 경고를 본 뒤 반사 명령을 몸이 받기까지(ms), shots·hits·kills: 쏜·맞힌·격파 수, damageTaken: 받은 피해",
      "type": "object",
      "properties": {
        "tickMicrosAvg": {
          "type": "number"
        },
        "tickMicrosMax": {
          "type": "number"
        },
        "commandsPerSecond": {
          "type": "number"
        },
        "lastReactionMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "shots": {
          "type": "integer"
        },
        "hits": {
          "type": "integer"
        },
        "kills": {
          "type": "integer"
        },
        "damageTaken": {
          "type": "number"
        }
      },
      "required": [
        "tickMicrosAvg",
        "tickMicrosMax",
        "commandsPerSecond",
        "lastReactionMs",
        "shots",
        "hits",
        "kills",
        "damageTaken"
      ],
      "additionalProperties": false
    },
    "BrainStatus": {
      "title": "BrainStatus",
      "type": "object",
      "properties": {
        "type": {
          "const": "brainStatus"
        },
        "simConnected": {
          "type": "boolean"
        },
        "autonomy": {
          "type": "boolean"
        },
        "simTime": {
          "type": [
            "number",
            "null"
          ]
        },
        "skill": {
          "$ref": "#/$defs/SkillState"
        },
        "activity": {
          "description": "지금 하는 일 (사람이 읽는 글)",
          "type": "string"
        },
        "target": {
          "description": "지금 노리는 유닛",
          "type": [
            "string",
            "null"
          ]
        },
        "reflex": {
          "oneOf": [
            {
              "$ref": "#/$defs/Reflex"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlanStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "planner": {
          "$ref": "#/$defs/PlannerStatus"
        }
      },
      "required": [
        "type",
        "simConnected",
        "autonomy",
        "simTime",
        "skill",
        "activity",
        "target",
        "reflex",
        "metrics",
        "plan",
        "planner"
      ],
      "additionalProperties": false
    },
    "DecisionKind": {
      "title": "DecisionKind",
      "description": "skill: 기술 바뀜, target: 표적 바뀜, fire: 사격, reflex: 반사 시작, result: 결과(맞힘·격파·피해), command: 몸이 명령을 거절함, plan: 느린 뇌의 계획(받음·짬·단계·마침·실패)",
      "enum": [
        "skill",
        "target",
        "fire",
        "reflex",
        "result",
        "command",
        "plan"
      ]
    },
    "Decision": {
      "title": "Decision",
      "description": "판단 기록 한 줄. text는 무엇을 보고 무엇을 정했는지.",
      "type": "object",
      "properties": {
        "type": {
          "const": "decision"
        },
        "seq": {
          "type": "integer"
        },
        "simTime": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "simTime",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "ControlResult": {
      "title": "ControlResult",
      "type": "object",
      "properties": {
        "type": {
          "const": "controlResult"
        },
        "id": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "accepted"
      ],
      "additionalProperties": false
    },
    "PlannerStatus": {
      "title": "PlannerStatus",
      "description": "느린 뇌가 쓰는 언어 모델. available이 false면 짧은 명령(규칙으로 알아듣는 것)만 따른다.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "available"
      ],
      "additionalProperties": false
    },
    "PlanStepView": {
      "title": "PlanStepView",
      "description": "계획의 한 단계와 진행 (waiting 기다림, running 하는 중, done 끝남)",
      "type": "object",
      "properties": {
        "skill": {
          "enum": [
            "idle",
            "hold",
            "engage",
            "retreat"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "evasion": {
          "enum": [
            "dodge",
            "guard",
            "both",
            "none"
          ]
        },
        "until": {
          "enum": [
            "targetDestroyed",
            "allDestroyed",
            "seconds",
            "hpBelow",
            "never"
          ]
        },
        "value": {
          "type": "number"
        },
        "state": {
          "enum": [
            "waiting",
            "running",
            "done"
          ]
        }
      },
      "required": [
        "skill",
        "target",
        "evasion",
        "until",
        "value",
        "state"
      ],
      "additionalProperties": false
    },
    "PlanTiming": {
      "title": "PlanTiming",
      "description": "명령을 받은 때부터 ms. firstTokenMs: 언어 모델의 첫 글자, firstStepMs: 첫 단계를 시작, totalMs: 계획을 다 짬",
      "type": "object",
      "properties": {
        "firstTokenMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "firstStepMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalMs": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "firstTokenMs",
        "firstStepMs",
        "totalMs"
      ],
      "additionalProperties": false
    },
    "PlanStatus": {
      "title": "PlanStatus",
      "description": "지금 계획. source: quick(규칙으로 바로)·cache(기억해 둔 계획)·llm(언어 모델). state: thinking 짜는 중·running 따르는 중·done 마침·failed 실패·cancelled 그만둠·retreating 체력이 낮아 물러나는 중",
      "type": "object",
      "properties": {
        "order": {
          "type": "string"
        },
        "source": {
          "enum": [
            "quick",
            "cache",
            "llm"
          ]
        },
        "state": {
          "enum": [
            "thinking",
            "running",
            "done",
            "failed",
            "cancelled",
            "retreating"
          ]
        },
        "say": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStepView"
          }
        },
        "current": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retreatBelowHp": {
          "type": "number"
        },
        "attempts": {
          "description": "언어 모델에 물은 횟수 (잘못된 계획이면 까닭을 붙여 한 번 더 묻는다)",
          "type": "integer"
        },
        "timing": {
          "$ref": "#/$defs/PlanTiming"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "order",
        "source",
        "state",
        "say",
        "steps",
        "current",
        "retreatBelowHp",
        "attempts",
        "timing",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
