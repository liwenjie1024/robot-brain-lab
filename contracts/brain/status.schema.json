{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-brain-lab.local/contracts/brain/status.schema.json",
  "title": "BrainMessage",
  "description": "두뇌가 화면에 보내는 메시지. 상태는 1초에 5번, 판단 기록과 지시의 답은 생길 때마다.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/BrainStatus" },
    { "$ref": "#/$defs/Decision" },
    { "$ref": "#/$defs/ControlResult" }
  ],
  "$defs": {
    "SkillState": {
      "title": "SkillState",
      "type": "object",
      "properties": {
        "name": { "enum": ["idle", "hold", "engage", "retreat"] },
        "target": { "description": "지시받은 표적 (없으면 두뇌가 고름)", "type": ["string", "null"] },
        "evasion": { "enum": ["dodge", "guard", "both", "none"] }
      },
      "required": ["name", "target", "evasion"],
      "additionalProperties": false
    },
    "Reflex": {
      "title": "Reflex",
      "description": "지금 하고 있는 반사 행동. kind: dodge 피하기·guard 막기·both 둘 다, threat: 조준한 유닛, until: 끝낼 시뮬레이션 시각",
      "type": "object",
      "properties": {
        "kind": { "enum": ["dodge", "guard", "both"] },
        "threat": { "type": "string" },
        "until": { "type": "number" }
      },
      "required": ["kind", "threat", "until"],
      "additionalProperties": false
    },
    "Metrics": {
      "title": "Metrics",
      "description": "tickMicrosAvg·Max: 판단 한 번에 걸린 시간(µs, 최근 5초), commandsPerSecond: 몸에 보낸 명령 수, lastReactionMs: 마지막 조준 경고를 본 뒤 반사 명령을 몸이 받기까지(ms), shots·hits·kills: 쏜·맞힌·격파 수, damageTaken: 받은 피해",
      "type": "object",
      "properties": {
        "tickMicrosAvg": { "type": "number" },
        "tickMicrosMax": { "type": "number" },
        "commandsPerSecond": { "type": "number" },
        "lastReactionMs": { "type": ["number", "null"] },
        "shots": { "type": "integer" },
        "hits": { "type": "integer" },
        "kills": { "type": "integer" },
        "damageTaken": { "type": "number" }
      },
      "required": ["tickMicrosAvg", "tickMicrosMax", "commandsPerSecond", "lastReactionMs", "shots", "hits", "kills", "damageTaken"],
      "additionalProperties": false
    },
    "BrainStatus": {
      "title": "BrainStatus",
      "type": "object",
      "properties": {
        "type": { "const": "brainStatus" },
        "simConnected": { "type": "boolean" },
        "autonomy": { "type": "boolean" },
        "simTime": { "type": ["number", "null"] },
        "skill": { "$ref": "#/$defs/SkillState" },
        "activity": { "description": "지금 하는 일 (사람이 읽는 글)", "type": "string" },
        "target": { "description": "지금 노리는 유닛", "type": ["string", "null"] },
        "reflex": { "oneOf": [{ "$ref": "#/$defs/Reflex" }, { "type": "null" }] },
        "metrics": { "$ref": "#/$defs/Metrics" }
      },
      "required": ["type", "simConnected", "autonomy", "simTime", "skill", "activity", "target", "reflex", "metrics"],
      "additionalProperties": false
    },
    "DecisionKind": {
      "title": "DecisionKind",
      "description": "skill: 기술 바뀜, target: 표적 바뀜, fire: 사격, reflex: 반사 시작, result: 결과(맞힘·격파·피해), command: 몸이 명령을 거절함",
      "enum": ["skill", "target", "fire", "reflex", "result", "command"]
    },
    "Decision": {
      "title": "Decision",
      "description": "판단 기록 한 줄. text는 무엇을 보고 무엇을 정했는지.",
      "type": "object",
      "properties": {
        "type": { "const": "decision" },
        "seq": { "type": "integer" },
        "simTime": { "type": ["number", "null"] },
        "kind": { "$ref": "#/$defs/DecisionKind" },
        "text": { "type": "string" }
      },
      "required": ["type", "seq", "simTime", "kind", "text"],
      "additionalProperties": false
    },
    "ControlResult": {
      "title": "ControlResult",
      "type": "object",
      "properties": {
        "type": { "const": "controlResult" },
        "id": { "type": "string" },
        "accepted": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "required": ["type", "accepted"],
      "additionalProperties": false
    }
  }
}
