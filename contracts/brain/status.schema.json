{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-brain-lab.local/contracts/brain/status.schema.json",
  "title": "BrainMessage",
  "description": "두뇌가 화면에 보내는 메시지. 상태는 1초에 5번, 판단 기록과 지시의 답은 생길 때마다.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/BrainStatus"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/ControlResult"
    }
  ],
  "$defs": {
    "SkillState": {
      "title": "SkillState",
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "idle",
            "hold",
            "engage",
            "retreat"
          ]
        },
        "target": {
          "description": "지시받은 표적 (없으면 두뇌가 고름)",
          "type": [
            "string",
            "null"
          ]
        },
        "evasion": {
          "enum": [
            "dodge",
            "guard",
            "both",
            "none"
          ]
        }
      },
      "required": [
        "name",
        "target",
        "evasion"
      ],
      "additionalProperties": false
    },
    "Reflex": {
      "title": "Reflex",
      "description": "지금 하고 있는 반사 행동. kind: dodge 피하기·guard 막기·both 둘 다, threat: 조준한 유닛, until: 끝낼 시뮬레이션 시각",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "dodge",
            "guard",
            "both"
          ]
        },
        "threat": {
          "type": "string"
        },
        "until": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "threat",
        "until"
      ],
      "additionalProperties": false
    },
    "Metrics": {
      "title": "Metrics",
      "description": "tickMicrosAvg·Max: 판단 한 번에 걸린 시간(µs, 최근 5초), commandsPerSecond: 몸에 보낸 명령 수, lastReactionMs: 마지막 조준 경고를 본 뒤 반사 명령을 몸이 받기까지(ms), shots·hits·kills: 쏜·맞힌·격파 수, damageTaken: 받은 피해",
      "type": "object",
      "properties": {
        "tickMicrosAvg": {
          "type": "number"
        },
        "tickMicrosMax": {
          "type": "number"
        },
        "commandsPerSecond": {
          "type": "number"
        },
        "lastReactionMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "shots": {
          "type": "integer"
        },
        "hits": {
          "type": "integer"
        },
        "kills": {
          "type": "integer"
        },
        "damageTaken": {
          "type": "number"
        }
      },
      "required": [
        "tickMicrosAvg",
        "tickMicrosMax",
        "commandsPerSecond",
        "lastReactionMs",
        "shots",
        "hits",
        "kills",
        "damageTaken"
      ],
      "additionalProperties": false
    },
    "BrainStatus": {
      "title": "BrainStatus",
      "type": "object",
      "properties": {
        "type": {
          "const": "brainStatus"
        },
        "simConnected": {
          "type": "boolean"
        },
        "autonomy": {
          "type": "boolean"
        },
        "simTime": {
          "type": [
            "number",
            "null"
          ]
        },
        "skill": {
          "$ref": "#/$defs/SkillState"
        },
        "activity": {
          "description": "지금 하는 일 (사람이 읽는 글)",
          "type": "string"
        },
        "target": {
          "description": "지금 노리는 유닛",
          "type": [
            "string",
            "null"
          ]
        },
        "reflex": {
          "oneOf": [
            {
              "$ref": "#/$defs/Reflex"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/PlanStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "planner": {
          "$ref": "#/$defs/PlannerStatus"
        },
        "trials": {
          "oneOf": [
            {
              "$ref": "#/$defs/TrialSeries"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "simConnected",
        "autonomy",
        "simTime",
        "skill",
        "activity",
        "target",
        "reflex",
        "metrics",
        "plan",
        "planner",
        "trials"
      ],
      "additionalProperties": false
    },
    "DecisionKind": {
      "title": "DecisionKind",
      "description": "skill: 기술 바뀜, target: 표적 바뀜, fire: 사격, reflex: 반사 시작, result: 결과(맞힘·격파·피해), command: 몸이 명령을 거절함, plan: 느린 뇌의 계획(받음·짬·단계·마침·실패), trial: 시험(판 시작·끝·멈춤)",
      "enum": [
        "skill",
        "target",
        "fire",
        "reflex",
        "result",
        "command",
        "plan",
        "trial"
      ]
    },
    "Decision": {
      "title": "Decision",
      "description": "판단 기록 한 줄. text는 무엇을 보고 무엇을 정했는지.",
      "type": "object",
      "properties": {
        "type": {
          "const": "decision"
        },
        "seq": {
          "type": "integer"
        },
        "simTime": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "simTime",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "ControlResult": {
      "title": "ControlResult",
      "type": "object",
      "properties": {
        "type": {
          "const": "controlResult"
        },
        "id": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "accepted"
      ],
      "additionalProperties": false
    },
    "PlannerStatus": {
      "title": "PlannerStatus",
      "description": "느린 뇌가 쓰는 언어 모델. available이 false면 짧은 명령(규칙으로 알아듣는 것)만 따른다.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "available"
      ],
      "additionalProperties": false
    },
    "PlanStepView": {
      "title": "PlanStepView",
      "description": "계획의 한 단계와 진행 (waiting 기다림, running 하는 중, done 끝남)",
      "type": "object",
      "properties": {
        "skill": {
          "enum": [
            "idle",
            "hold",
            "engage",
            "retreat"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "evasion": {
          "enum": [
            "dodge",
            "guard",
            "both",
            "none"
          ]
        },
        "until": {
          "enum": [
            "targetDestroyed",
            "allDestroyed",
            "seconds",
            "hpBelow",
            "never"
          ]
        },
        "value": {
          "type": "number"
        },
        "state": {
          "enum": [
            "waiting",
            "running",
            "done"
          ]
        }
      },
      "required": [
        "skill",
        "target",
        "evasion",
        "until",
        "value",
        "state"
      ],
      "additionalProperties": false
    },
    "PlanTiming": {
      "title": "PlanTiming",
      "description": "명령을 받은 때부터 ms. firstTokenMs: 언어 모델의 첫 글자, firstStepMs: 첫 단계를 시작, totalMs: 계획을 다 짬",
      "type": "object",
      "properties": {
        "firstTokenMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "firstStepMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalMs": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "firstTokenMs",
        "firstStepMs",
        "totalMs"
      ],
      "additionalProperties": false
    },
    "PlanStatus": {
      "title": "PlanStatus",
      "description": "지금 계획. source: quick(규칙으로 바로)·cache(기억해 둔 계획)·llm(언어 모델). state: thinking 짜는 중·running 따르는 중·done 마침·failed 실패·cancelled 그만둠·retreating 체력이 낮아 물러나는 중",
      "type": "object",
      "properties": {
        "order": {
          "type": "string"
        },
        "source": {
          "enum": [
            "quick",
            "cache",
            "llm"
          ]
        },
        "state": {
          "enum": [
            "thinking",
            "running",
            "done",
            "failed",
            "cancelled",
            "retreating"
          ]
        },
        "say": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStepView"
          }
        },
        "current": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retreatBelowHp": {
          "type": "number"
        },
        "attempts": {
          "description": "언어 모델에 물은 횟수 (잘못된 계획이면 까닭을 붙여 한 번 더 묻는다)",
          "type": "integer"
        },
        "timing": {
          "$ref": "#/$defs/PlanTiming"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "order",
        "source",
        "state",
        "say",
        "steps",
        "current",
        "retreatBelowHp",
        "attempts",
        "timing",
        "error"
      ],
      "additionalProperties": false
    },
    "Stat": {
      "title": "Stat",
      "description": "여러 판의 값: 가운데 값(median)·가장 작은 값·가장 큰 값·평균",
      "type": "object",
      "properties": {
        "median": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "mean": {
          "type": "number"
        }
      },
      "required": [
        "median",
        "min",
        "max",
        "mean"
      ],
      "additionalProperties": false
    },
    "RunResult": {
      "title": "RunResult",
      "description": "한 판의 결과. outcome: cleared 드론을 다 격파·destroyed 기체가 파괴됨·timeout 제한 시간이 지남. 판은 두뇌가 맡은 때(장면을 되돌린 뒤 startDelayS초)에 시작하고, 시간·피해는 그때부터 시뮬레이션 초로 잰다. damageTaken은 체력이 준 만큼. reactionMs는 이 판의 반사 반응 시간 평균. plan*은 말로 한 명령일 때만.",
      "type": "object",
      "properties": {
        "run": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "cleared",
            "destroyed",
            "timeout"
          ]
        },
        "startDelayS": {
          "description": "장면을 되돌린 뒤 두뇌가 맡기까지 늦춘 초",
          "type": "number"
        },
        "durationS": {
          "type": "number"
        },
        "clearTimeS": {
          "type": [
            "number",
            "null"
          ]
        },
        "drones": {
          "type": "integer"
        },
        "kills": {
          "type": "integer"
        },
        "damageTaken": {
          "type": "number"
        },
        "shots": {
          "type": "integer"
        },
        "hits": {
          "type": "integer"
        },
        "reactionMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "planFirstStepMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "planTotalMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "planAttempts": {
          "type": [
            "integer",
            "null"
          ]
        },
        "score": {
          "description": "0~100 (shared/src/brain/trialScore.ts)",
          "type": "number"
        }
      },
      "required": [
        "run",
        "outcome",
        "startDelayS",
        "durationS",
        "clearTimeS",
        "drones",
        "kills",
        "damageTaken",
        "shots",
        "hits",
        "reactionMs",
        "planFirstStepMs",
        "planTotalMs",
        "planAttempts",
        "score"
      ],
      "additionalProperties": false
    },
    "SetupSummary": {
      "title": "SetupSummary",
      "description": "비교할 것 하나의 여러 판 모음. cleared: 다 격파한 판 수, clearTimeS: 다 격파한 판만, accuracy: 맞힌 수 ÷ 쏜 수 (쏘지 않았으면 null)",
      "type": "object",
      "properties": {
        "runs": {
          "type": "integer"
        },
        "cleared": {
          "type": "integer"
        },
        "score": {
          "$ref": "#/$defs/Stat"
        },
        "clearTimeS": {
          "oneOf": [
            {
              "$ref": "#/$defs/Stat"
            },
            {
              "type": "null"
            }
          ]
        },
        "damageTaken": {
          "$ref": "#/$defs/Stat"
        },
        "accuracy": {
          "type": [
            "number",
            "null"
          ]
        },
        "reactionMs": {
          "oneOf": [
            {
              "$ref": "#/$defs/Stat"
            },
            {
              "type": "null"
            }
          ]
        },
        "planFirstStepMs": {
          "oneOf": [
            {
              "$ref": "#/$defs/Stat"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runs",
        "cleared",
        "score",
        "clearTimeS",
        "damageTaken",
        "accuracy",
        "reactionMs",
        "planFirstStepMs"
      ],
      "additionalProperties": false
    },
    "SetupResults": {
      "title": "SetupResults",
      "type": "object",
      "properties": {
        "setup": {
          "$ref": "control.schema.json#/$defs/TrialSetup"
        },
        "label": {
          "description": "사람이 읽는 이름 (예: 교전 · 피하기)",
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunResult"
          }
        },
        "summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/SetupSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "setup",
        "label",
        "results",
        "summary"
      ],
      "additionalProperties": false
    },
    "TrialProgress": {
      "title": "TrialProgress",
      "description": "지금 도는 판. setup: 비교할 것의 번호(0부터), run: 판 번호(1부터), phase: resetting 장면을 되돌리는 중·waiting 두뇌가 맡기를 기다리는 중(판마다 늦춤)·running 도는 중, elapsedS: 두뇌가 맡은 뒤 지난 시뮬레이션 초",
      "type": "object",
      "properties": {
        "setup": {
          "type": "integer",
          "minimum": 0
        },
        "run": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "resetting",
            "waiting",
            "running"
          ]
        },
        "startDelayS": {
          "description": "이 판에서 두뇌가 맡기까지 늦추는 초",
          "type": "number"
        },
        "elapsedS": {
          "type": "number"
        }
      },
      "required": [
        "setup",
        "run",
        "phase",
        "startDelayS",
        "elapsedS"
      ],
      "additionalProperties": false
    },
    "TrialSeries": {
      "title": "TrialSeries",
      "description": "시험 한 묶음 (화면에 보이고, 끝나면 results/trials에 JSON으로 남긴다). state: running 도는 중·done 다 돌림·stopped 사람이 멈춤·failed 더 돌릴 수 없음(error에 까닭)",
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "running",
            "done",
            "stopped",
            "failed"
          ]
        },
        "scenario": {
          "type": "string"
        },
        "runs": {
          "type": "integer"
        },
        "timeLimitS": {
          "type": "number"
        },
        "startSpreadS": {
          "type": "number"
        },
        "startedAt": {
          "description": "시작한 때 (ISO 8601)",
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "setups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupResults"
          }
        },
        "current": {
          "oneOf": [
            {
              "$ref": "#/$defs/TrialProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "savedTo": {
          "description": "결과를 남긴 파일 (남기지 못했으면 null)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "scenario",
        "runs",
        "timeLimitS",
        "startSpreadS",
        "startedAt",
        "finishedAt",
        "setups",
        "current",
        "error",
        "savedTo"
      ],
      "additionalProperties": false
    }
  }
}
