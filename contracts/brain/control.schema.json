{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-brain-lab.local/contracts/brain/control.schema.json",
  "title": "BrainControl",
  "description": "화면(나중에는 느린 뇌 System 2)이 두뇌에게 보내는 지시. 두뇌는 controlResult로 답한다.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/SetSkill" },
    { "$ref": "#/$defs/SetAutonomy" }
  ],
  "$defs": {
    "ControlId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "SkillName": {
      "title": "SkillName",
      "description": "idle: 아무것도 안 함(멈춤), hold: 자리 지키기, engage: 교전, retreat: 물러나기",
      "enum": ["idle", "hold", "engage", "retreat"]
    },
    "Evasion": {
      "title": "Evasion",
      "description": "조준 경고를 받았을 때. dodge: 옆으로 피하기, guard: 방패로 막기, both: 둘 다, none: 하지 않음",
      "enum": ["dodge", "guard", "both", "none"]
    },
    "SetSkill": {
      "title": "SetSkill",
      "description": "기술을 고른다. target은 교전할 드론 (없으면 두뇌가 고른다).",
      "type": "object",
      "properties": {
        "type": { "const": "setSkill" },
        "id": { "$ref": "#/$defs/ControlId" },
        "skill": { "$ref": "#/$defs/SkillName" },
        "target": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evasion": { "$ref": "#/$defs/Evasion" }
      },
      "required": ["type", "skill"],
      "additionalProperties": false
    },
    "SetAutonomy": {
      "title": "SetAutonomy",
      "description": "enabled: true면 두뇌가 몸에 명령을 보내고, false면 보기만 한다 (사람이 조종).",
      "type": "object",
      "properties": {
        "type": { "const": "setAutonomy" },
        "id": { "$ref": "#/$defs/ControlId" },
        "enabled": { "type": "boolean" }
      },
      "required": ["type", "enabled"],
      "additionalProperties": false
    }
  }
}
