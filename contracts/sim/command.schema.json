{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-brain-lab.local/contracts/sim/command.schema.json",
  "title": "SimCommand",
  "description": "몸(시뮬레이터)에 보내는 명령. 값의 범위는 몸마다 달라 GET /scene의 limits로 알리고 시뮬레이터가 확인한다.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/VelocityCommand" },
    { "$ref": "#/$defs/StopCommand" },
    { "$ref": "#/$defs/AimCommand" },
    { "$ref": "#/$defs/AimPointCommand" },
    { "$ref": "#/$defs/LowerAimCommand" },
    { "$ref": "#/$defs/GuardCommand" },
    { "$ref": "#/$defs/FireCommand" },
    { "$ref": "#/$defs/PushCommand" },
    { "$ref": "#/$defs/ResetCommand" }
  ],
  "$defs": {
    "CommandId": {
      "description": "보낸 쪽이 정하는 번호. 시뮬레이터가 받았는지(ack)·거절했는지(rejected)를 이 번호로 알린다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "Vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "VelocityCommand": {
      "title": "VelocityCommand",
      "description": "비행 속도 (기수 방향 기준). 비행 제어(System 0)가 기체를 똑바로 세운 채 이 속도로 난다. 다음 명령까지 유지한다. forward: 앞(+)/뒤(-) m/s, sideways: 왼쪽(+)/오른쪽(-) m/s, up: 위(+)/아래(-) m/s, turn: 왼쪽으로 도는(+) rad/s",
      "type": "object",
      "properties": {
        "type": { "const": "velocity" },
        "id": { "$ref": "#/$defs/CommandId" },
        "forward": { "type": "number" },
        "sideways": { "type": "number" },
        "up": { "type": "number" },
        "turn": { "type": "number" }
      },
      "required": ["type", "forward", "sideways", "up", "turn"],
      "additionalProperties": false
    },
    "StopCommand": {
      "title": "StopCommand",
      "description": "그 자리에 멈춘다 (공중이면 떠 있고, 땅에 닿아 느려지면 추진기를 끄고 선다).",
      "type": "object",
      "properties": {
        "type": { "const": "stop" },
        "id": { "$ref": "#/$defs/CommandId" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "AimCommand": {
      "title": "AimCommand",
      "description": "유닛(표적)을 소총으로 겨누고 계속 따라간다. 팔이 실제로 돌아가는 데 시간이 걸린다 (상태의 aimError).",
      "type": "object",
      "properties": {
        "type": { "const": "aim" },
        "id": { "$ref": "#/$defs/CommandId" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["type", "unit"],
      "additionalProperties": false
    },
    "AimPointCommand": {
      "title": "AimPointCommand",
      "description": "세계 좌표의 한 점을 겨눈다 [x, y, z] m.",
      "type": "object",
      "properties": {
        "type": { "const": "aimPoint" },
        "id": { "$ref": "#/$defs/CommandId" },
        "point": { "$ref": "#/$defs/Vector3" }
      },
      "required": ["type", "point"],
      "additionalProperties": false
    },
    "LowerAimCommand": {
      "title": "LowerAimCommand",
      "description": "겨누기를 그만두고 소총을 내린다.",
      "type": "object",
      "properties": {
        "type": { "const": "lowerAim" },
        "id": { "$ref": "#/$defs/CommandId" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "GuardCommand": {
      "title": "GuardCommand",
      "description": "방패를 올리거나(raised: true) 내린다. unit을 주면 그 유닛 쪽에서 몸통으로 오는 사격 길에, 없으면 기수 방향 앞에 든다. 방패에 맞은 사격은 피해가 없다.",
      "type": "object",
      "properties": {
        "type": { "const": "guard" },
        "id": { "$ref": "#/$defs/CommandId" },
        "raised": { "type": "boolean" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["type", "raised"],
      "additionalProperties": false
    },
    "FireCommand": {
      "title": "FireCommand",
      "description": "빔 소총을 한 번 쏜다. 총열이 실제로 가리키는 방향으로 나간다. 식는 중이거나 에너지가 모자라면 거절한다.",
      "type": "object",
      "properties": {
        "type": { "const": "fire" },
        "id": { "$ref": "#/$defs/CommandId" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "PushCommand": {
      "title": "PushCommand",
      "description": "시험용: 몸통을 잠깐 민다 (맞았을 때의 충격을 흉내 낸다). force: 세계 좌표의 힘 [x, y, z] N, durationMs: 미는 시간 ms",
      "type": "object",
      "properties": {
        "type": { "const": "push" },
        "id": { "$ref": "#/$defs/CommandId" },
        "force": { "$ref": "#/$defs/Vector3" },
        "durationMs": { "type": "integer" }
      },
      "required": ["type", "force", "durationMs"],
      "additionalProperties": false
    },
    "ScenarioName": {
      "title": "ScenarioName",
      "description": "시험 장면. empty: 빈 시험장, targets: 멈춘 표적, moving: 움직이는 표적, skirmish: 반격하는 드론",
      "enum": ["empty", "targets", "moving", "skirmish"]
    },
    "ResetCommand": {
      "title": "ResetCommand",
      "description": "처음으로 되돌린다. scenario를 주면 그 시험 장면으로, 없으면 지금 장면으로.",
      "type": "object",
      "properties": {
        "type": { "const": "reset" },
        "id": { "$ref": "#/$defs/CommandId" },
        "scenario": { "$ref": "#/$defs/ScenarioName" }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  }
}
