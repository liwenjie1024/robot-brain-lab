{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Policy",
  "description": "一个练出来的策略（小脑层）看什么、出什么。训练那边导出策略时写它；测试台照它把策略接到身体上，对不上就不跑，不猜。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "name", "body", "trained", "onnx", "rate_hz", "imu_site", "joints", "observations", "command"],
  "properties": {
    "contract_version": {
      "const": 1,
      "description": "规约的版本。规约里哪个数的意思变了就加一，旧的策略就不能直接用了"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "策略的名字（也是放它的目录的名字）"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "sha256"],
      "description": "练的时候用的身体",
      "properties": {
        "name": {
          "type": "string",
          "description": "身体的名字，比如 unitree_g1"
        },
        "model": {
          "type": "string",
          "description": "练的时候用的身体模型（MJCF），相对这份文件的路径"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "trained": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "source", "task", "iterations", "date"],
      "description": "怎么练出来的",
      "properties": {
        "tool": {
          "type": "string",
          "description": "训练的工具，比如 mjlab"
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "工具的代码从哪来，写死在一个提交号上"
        },
        "task": {
          "type": "string",
          "description": "练的是哪个任务"
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "description": "练了多少轮"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "onnx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "input", "output"],
      "description": "策略本身（ONNX）。输入一行观测，输出一行动作",
      "properties": {
        "file": {
          "type": "string",
          "description": "相对这份文件的路径"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "input": {
          "type": "string",
          "description": "输入的名字。长度是 observations 每一项的 size 加起来"
        },
        "output": {
          "type": "string",
          "description": "输出的名字。长度是 joints 的个数"
        }
      }
    },
    "rate_hz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "每秒算几次。仿真每这么久用一次策略，中间关节的目标不变"
    },
    "imu_site": {
      "type": "string",
      "description": "量身体速度的那个 IMU 在模型里的点（site）。base_lin_vel、base_ang_vel 是在它的坐标里量的"
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "description": "策略管的关节，按动作的顺序。观测里的关节（joint_pos、joint_vel、last_action）也是这个顺序",
      "items": {
        "$ref": "#/$defs/Joint"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "description": "观测按这个顺序接成一行，每一项先乘 scale",
      "items": {
        "$ref": "#/$defs/Observation"
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "ranges"],
      "description": "给策略的命令（走的速度）：在 observations 里 command 那一项，按 fields 的顺序",
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CommandField"
          }
        },
        "ranges": {
          "type": "object",
          "description": "练的时候每一项命令的范围。超出范围的命令测试台不剪，拒绝",
          "propertyNames": {
            "$ref": "#/$defs/CommandField"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Range"
          }
        }
      }
    },
    "height_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_body", "alignment", "size_m", "resolution_m", "offset_m", "max_distance_m", "geom_groups"],
      "description": "observations 里有 height_scan 时才有（有它就要有那一项）。从 frame_body 那一点往下打一片竖直的射线：网格只跟着它转偏航（alignment 是 yaw），x × y，每 resolution 一个点、两头都有，先 y 后 x 地排；只打固定在世界上、在 geom_groups 里的形状，frame_body 自己不打。每个点的值是 frame_body 比打到的点高多少（m），打不到或者比 max_distance_m 远就是 max_distance_m",
      "properties": {
        "frame_body": {
          "type": "string",
          "description": "射线从这个身体（body）的原点出发，比如 pelvis"
        },
        "alignment": {
          "const": "yaw",
          "description": "网格怎么跟着身体转：只跟着转偏航（不跟着前后、左右歪），射线一直竖直朝下"
        },
        "size_m": {
          "$ref": "#/$defs/PlaneSize"
        },
        "resolution_m": {
          "$ref": "#/$defs/PlaneStep"
        },
        "offset_m": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2,
          "description": "网格的中心在偏航坐标里挪多少（往前、往左，m）"
        },
        "max_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geom_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 5 },
          "description": "只打这几组形状（MuJoCo 的 geom group）：地面在这几组，身体自己的形状在别的组"
        }
      }
    }
  },
  "$defs": {
    "PlaneSize": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
      "items": false,
      "minItems": 2,
      "description": "网格多大：往前、往左（m）"
    },
    "PlaneStep": {
      "type": "array",
      "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
      "items": false,
      "minItems": 2,
      "description": "每隔多远一个点：往前、往左（m）"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Range": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "description": "[最小, 最大]"
    },
    "CommandField": {
      "enum": ["lin_vel_x", "lin_vel_y", "ang_vel_z"],
      "description": "lin_vel_x 往前（m/s），lin_vel_y 往左（m/s），ang_vel_z 往左转（rad/s）；都按身体自己的方向"
    },
    "Joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_position_rad", "action_scale_rad", "stiffness_nm_per_rad", "damping_nms_per_rad", "torque_limit_nm"],
      "properties": {
        "name": {
          "type": "string",
          "description": "模型里关节的名字"
        },
        "default_position_rad": {
          "type": "number",
          "description": "默认的姿势。关节的目标 = 它 + 动作 x action_scale_rad"
        },
        "action_scale_rad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "动作是 1 的时候，目标离默认的姿势多少弧度"
        },
        "stiffness_nm_per_rad": {
          "type": "number",
          "minimum": 0,
          "description": "关节位置控制的刚度：力矩 = 刚度 x (目标 - 角度) - 阻尼 x 转速"
        },
        "damping_nms_per_rad": {
          "type": "number",
          "minimum": 0
        },
        "torque_limit_nm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "练的时候这个关节最多出多大的力矩"
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "size", "scale"],
      "properties": {
        "term": {
          "enum": ["base_lin_vel", "base_ang_vel", "projected_gravity", "joint_pos", "joint_vel", "last_action", "command", "height_scan"],
          "description": "base_lin_vel、base_ang_vel：IMU 那一点的速度、角速度（在 IMU 的坐标里，m/s、rad/s）。projected_gravity：重力的方向（单位向量，在骨盆的坐标里）。joint_pos：关节角度减默认的姿势（rad）。joint_vel：关节的转速（rad/s）。last_action：上一次的动作。command：命令。height_scan：脚下的高度（m，怎么量写在 height_scan 里）"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
